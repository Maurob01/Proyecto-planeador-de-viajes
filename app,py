import tkinter as tk
from tkinter import messagebox
from Motor.red import Red

class AppTransMilenio:
    def __init__(self, root):
        self.root = root
        self.root.title("Planeador de Viajes - TransMilenio")
        self.root.geometry("600x450")
        self.root.resizable(False, False)

        # Instanciar la red (asume que la carpeta Datos está al mismo nivel)
        try:
            self.red = Red(carpeta_datos="Datos")
        except Exception as e:
            messagebox.showerror("Error", f"No se pudieron cargar los datos: {e}")

        # --- TÍTULO ---
        self.lbl_titulo = tk.Label(root, text="Buscador de Estaciones TransMilenio", font=("Arial", 16, "bold"), fg="#D32F2F")
        self.lbl_titulo.pack(pady=20)

        # --- CAMPO DE BÚSQUEDA ---
        self.frame_busqueda = tk.Frame(root)
        self.frame_busqueda.pack(pady=10, fill="x", padx=40)

        self.label_busqueda = tk.Label(self.frame_busqueda, text="Nombre de la estación:", font=("Arial", 11))
        self.label_busqueda.pack(anchor="w", pady=2)

        self.input_estacion = tk.Entry(self.frame_busqueda, font=("Arial", 12), relief="solid", bd=1)
        self.input_estacion.pack(fill="x", pady=5, ipady=5)

        # --- BOTÓN DE CONSULTA ---
        self.btn_consultar = tk.Button(
            root, text="Consultar Estado", font=("Arial", 11, "bold"), 
            bg="#E53935", fg="white", activebackground="#C62828", 
            activeforeground="white", relief="flat", cursor="hand2", 
            command=self.consultar_estacion
        )
        self.btn_consultar.pack(pady=15, ipadx=10, ipady=5)

        # --- TARJETA DE RESULTADO ---
        self.resultado_frame = tk.Frame(root, bg="#F5F5F5", relief="solid", bd=1)
        self.resultado_frame.pack(pady=10, fill="x", padx=40, ipady=15)

        self.lbl_resultado_titulo = tk.Label(self.resultado_frame, text="Resultado:", font=("Arial", 12, "bold"), bg="#F5F5F5")
        self.lbl_resultado_titulo.pack(pady=5)

        self.lbl_estado = tk.Label(self.resultado_frame, text="Ingresa una estación para ver su estado", font=("Arial", 12), bg="#F5F5F5", fg="#555555")
        self.lbl_estado.pack(pady=5)

    def consultar_estacion(self):
        nombre_buscado = self.input_estacion.get().strip()
        if not nombre_buscado:
            messagebox.showwarning("Advertencia", "Por favor ingresa el nombre de una estación.")
            return

        try:
            # Llamamos al método estado de tu clase Red
            estado_actual = self.red.estado(nombre_buscado)
            
            # Mostramos el resultado según el estado devuelto
            if "Abierta" in estado_actual or "abierta" in estado_actual:
                self.lbl_estado.config(text=f"Estación: {nombre_buscado.upper()}\nEstado: 🟢 {estado_actual}", fg="green")
            else:
                self.lbl_estado.config(text=f"Estación: {nombre_buscado.upper()}\nEstado: 🔴 {estado_actual}", fg="red")
        except Exception as e:
            self.lbl_estado.config(text="No se encontró la estación o hubo un error.", fg="orange")

if __name__ == "__main__":
    root = tk.Tk()
    app = AppTransMilenio(root)
    root.mainloop()